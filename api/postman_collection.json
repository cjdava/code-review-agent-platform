{
  "info": {
    "name": "Code Review Agent Platform",
    "description": "Minimal collection for the local FastAPI service in app.py. Start the server with `uvicorn app:app --reload` before running requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "owner", "value": "cjdava" },
    { "key": "repo", "value": "PeerReviewSample" },
    { "key": "pr_number", "value": "29" },
    { "key": "framework", "value": "dotnet" }
  ],
  "item": [
    {
      "name": "Docs",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/docs", "host": ["{{base_url}}"], "path": ["docs"] }
      }
    },
    {
      "name": "Create Review",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/reviews", "host": ["{{base_url}}"], "path": ["reviews"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"owner\": \"{{owner}}\",\n  \"repo\": \"{{repo}}\",\n  \"pr_number\": {{pr_number}},\n  \"framework\": \"{{framework}}\"\n}"
        },
        "description": "Matches the request verified end-to-end during testing. framework is optional (default \"auto\"): dotnet, python, react, qa, database, or comma-separated for multi-domain, e.g. \"python,qa\"."
      }
    }
  ]
}
